# Copie este arquivo para ".env" e preencha com as credenciais do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration).
# Sem essas variáveis o app sobe normalmente E FUNCIONA — ele cai automaticamente em modo mock
# (ver src/config/mock-mode.ts e src/mocks/), com dados e login fictícios em memória, sem
# precisar de nenhuma integração externa. Preencha as variáveis abaixo para usar o Firebase real.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional — força o modo mock ligado/desligado independente do .env acima estar preenchido.
# Deixe vazio/ausente para o comportamento automático (mock só quando faltam variáveis Firebase).
# EXPO_PUBLIC_USE_MOCKS=true
