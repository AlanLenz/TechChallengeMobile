rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Arquivos do usuário (recibos de transação e afins): só o dono lê, escreve e apaga.
    // Espelha a regra do Firestore (users/{userId} exige request.auth.uid == userId).
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    // Avatares do perfil (src/modules/profile) — leitura autenticada, escrita só do dono.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
